import { useEffect, useState } from 'react'
import { apiClient } from '../lib/apiClient'

function StackItem({ ok, label }) {
  return (
    <div style={{
      display: 'flex',
      alignItems: 'center',
      gap: '0.5rem',
      padding: '0.5rem 0.75rem',
      borderRadius: '6px',
      background: ok ? '#ecfdf5' : '#fffbeb',
      color: ok ? '#065f46' : '#92400e',
      fontWeight: 500
    }}>
      <span aria-hidden="true">{ok ? '✓' : '⚠'}</span>
      <span>{label}</span>
    </div>
  )
}

function Home() {
  const [welcome, setWelcome] = useState(null)
  const [error, setError] = useState(null)
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    let cancelled = false

    apiClient('/')
      .then((data) => {
        if (!cancelled) {
          setWelcome(data)
          setLoading(false)
        }
      })
      .catch((err) => {
        if (!cancelled) {
          setError(err.message || 'Failed to reach API')
          setLoading(false)
        }
      })

    return () => { cancelled = true }
  }, [])

  if (loading) {
    return (
      <main style={styles.main}>
        <p style={{ color: '#6b7280' }}>Connecting to API…</p>
      </main>
    )
  }

  if (error) {
    return (
      <main style={styles.main}>
        <h1><%= @module_name %></h1>
        <p style={{ color: '#b91c1c', marginTop: '0.75rem' }}>
          Could not load welcome data from the API.
        </p>
        <p style={{ color: '#6b7280', marginTop: '0.5rem', fontSize: '0.95rem' }}>
          {error}
        </p>
        <p style={{ marginTop: '1rem', fontSize: '0.9rem' }}>
          Check <code>VITE_API_URL</code> (run <code>belt frontend env dev</code>) and that CORS allows this origin.
        </p>
      </main>
    )
  }

  const stack = welcome.stack || {}

  return (
    <main style={styles.main}>
      <h1 style={{ fontSize: '1.75rem', marginBottom: '0.35rem' }}>
        {welcome.title || '<%= @module_name %>'}
      </h1>
      <p style={{ color: '#4b5563', marginBottom: '1.5rem' }}>
        {welcome.subtitle || 'Your Belt app is running.'}
      </p>

      <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.5rem', alignItems: 'center', marginBottom: '2rem' }}>
        <StackItem ok={!!stack.api_gateway} label="API Gateway" />
        <span style={{ color: '#9ca3af' }}>→</span>
        <StackItem ok={!!stack.lambda} label="Lambda" />
        <span style={{ color: '#9ca3af' }}>→</span>
        <StackItem ok={!!stack.dynamodb} label="DynamoDB" />
      </div>

      {Array.isArray(welcome.next_steps) && welcome.next_steps.length > 0 && (
        <section>
          <h2 style={{ fontSize: '1.1rem', marginBottom: '0.75rem' }}>Next Steps</h2>
          <ol style={{ paddingLeft: '1.25rem', color: '#374151', lineHeight: 1.7 }}>
            {welcome.next_steps.map((step, i) => (
              <li key={i}>{step}</li>
            ))}
          </ol>
        </section>
      )}

      <p style={{ marginTop: '2rem', fontSize: '0.85rem', color: '#9ca3af' }}>
        Edit <code>src/pages/Home.jsx</code> to replace this page.
      </p>
    </main>
  )
}

const styles = {
  main: {
    padding: '2rem',
    maxWidth: '720px',
    margin: '0 auto',
    fontFamily: 'system-ui, -apple-system, sans-serif'
  },
  code: {
    fontSize: '0.9em',
    background: '#f3f4f6',
    padding: '0.1rem 0.35rem',
    borderRadius: '4px'
  }
}

export default Home
