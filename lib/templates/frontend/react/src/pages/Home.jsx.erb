import { useEffect, useState } from 'react'
import { apiClient } from '../lib/apiClient'

// Mirrors lib/belt/assets/welcome.css so SPA and Lambda HTML welcome match.
const welcomeStyles = `
  * { margin: 0; padding: 0; box-sizing: border-box; }
  .belt-welcome {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #f8f9fa;
    color: #2d3748;
    min-height: 100vh;
  }
  .belt-welcome .hero {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .belt-welcome .hero-bg {
    width: 100%;
    height: auto;
    display: block;
  }
  .belt-welcome .overlay {
    position: absolute;
    top: 35%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 2rem 3rem;
    background: rgba(255, 255, 255, 0.50);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 12px;
    text-align: center;
    max-width: 600px;
    width: 90%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }
  .belt-welcome .overlay h1 {
    font-size: 2.2rem;
    font-weight: 700;
    color: #2d3748;
    margin-bottom: 0.4rem;
  }
  .belt-welcome .overlay .subtitle {
    font-size: 1.1rem;
    color: #4a5568;
  }
  .belt-welcome .container {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem;
  }
  .belt-welcome .stack-check {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .belt-welcome .check-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 500;
  }
  .belt-welcome .check-pass {
    background: rgba(39, 174, 96, 0.1);
    border: 1px solid rgba(39, 174, 96, 0.3);
    color: #1e8449;
  }
  .belt-welcome .check-neutral {
    background: rgba(113, 128, 150, 0.08);
    border: 1px solid rgba(113, 128, 150, 0.25);
    color: #4a5568;
  }
  .belt-welcome .icon { font-size: 1.1rem; }
  .belt-welcome .arrow { color: #718096; font-size: 1.2rem; }
  .belt-welcome .dynamodb-hint {
    text-align: center;
    margin: -0.5rem 0 1.75rem;
    color: #4a5568;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .belt-welcome .dynamodb-hint code,
  .belt-welcome .next-steps code {
    background: rgba(99, 45, 145, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    color: #632d91;
    font-size: 0.85rem;
  }
  .belt-welcome .next-steps {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
  }
  .belt-welcome .next-steps h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: #2d3748;
  }
  .belt-welcome .next-steps ol { padding-left: 1.5rem; }
  .belt-welcome .next-steps li {
    margin-bottom: 0.6rem;
    color: #4a5568;
    line-height: 1.5;
  }
  .belt-welcome .status-main {
    padding: 3rem 2rem;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #4a5568;
  }
  .belt-welcome .status-main h1 {
    font-size: 1.75rem;
    color: #2d3748;
    margin-bottom: 0.75rem;
  }
  .belt-welcome .error { color: #b91c1c; margin-top: 0.75rem; }
  .belt-welcome .muted { color: #6b7280; margin-top: 0.5rem; font-size: 0.95rem; }
  .belt-welcome .footer-note {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: #9ca3af;
    text-align: center;
  }
  .belt-welcome .footer-note code {
    background: #f3f4f6;
