    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
  .belt-welcome .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .belt-welcome .overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 1.35rem 1.6rem 1.25rem;
    background: rgba(255, 255, 255, 0.55);
