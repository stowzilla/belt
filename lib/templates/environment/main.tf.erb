terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
    conveyor-belt = {
      source  = "stowzilla/conveyor-belt"
      version = "~> 0.0.1"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "<%= @app_name.capitalize %>"
      Environment = var.environment
      ManagedBy   = "Terraform"
    }
  }
}

provider "conveyor-belt" {
  environment = var.environment
  aws_region  = var.aws_region
}

resource "conveyor_belt" "main" {
  source            = "${path.module}/../routes.tf.rb"
  app_name          = var.app_name
  lambda_source_dir = "${path.module}/../../lambda"
  lambda_shared_dirs = ["controllers", "helpers", "lib", "models", "templates"]
  frontend_urls     = ["http://localhost:3000"]
  friendly_errors   = true
}
