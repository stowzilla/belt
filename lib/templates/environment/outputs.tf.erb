output "api_url" {
  description = "API Gateway base URL"
  value       = module.app.api_url
}

output "api_urls" {
  description = "Map of gateway names to API Gateway URLs"
  value       = module.app.api_urls
}

output "lambda_functions" {
  description = "Map of action names to Lambda function ARNs"
  value       = module.app.lambda_functions
}

output "app_domain" {
  description = "The application domain for this environment"
  value       = module.app.app_domain
}

output "name_servers" {
  description = "NS records to configure at your domain registrar (only when domain is set)"
  value       = try(module.app.name_servers, [])
}

output "frontend_bucket_name" {
  description = "S3 bucket for frontend assets"
  value       = try(module.app.frontend_bucket_name, "")
}

output "frontend_distribution_id" {
  description = "CloudFront distribution ID"
  value       = try(module.app.frontend_distribution_id, "")
}

output "frontend_url" {
  description = "Frontend URL"
  value       = try(module.app.frontend_url, "")
}

# --- Apex DNS sync outputs ---
# `belt deploy prod` reads these to copy the apex, www and api alias records into
# the root zone. Without them the records never reach the zone the registrar sees.

output "cloudfront_domain_name" {
  description = "CloudFront distribution domain name (for DNS alias)"
  value       = try(module.app.cloudfront_domain_name, "")
}

output "cloudfront_hosted_zone_id" {
  description = "CloudFront hosted zone ID"
  value       = try(module.app.cloudfront_hosted_zone_id, "")
}

output "api_gateway_domain_name" {
  description = "API Gateway custom domain regional domain name"
  value       = try(module.app.api_gateway_domain_name, "")
}

output "api_gateway_hosted_zone_id" {
  description = "API Gateway custom domain hosted zone ID"
  value       = try(module.app.api_gateway_hosted_zone_id, "")
}
