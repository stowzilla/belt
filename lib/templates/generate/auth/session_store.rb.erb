# frozen_string_literal: true

# SessionStore — the persistence seam Belt::Authentication::SessionCookie::Flow depends on,
# backed by the app's Session model and User's credential_revision.
# Generated by: belt generate auth --session-cookie
#
# Flow never touches the database directly; it calls the six methods below. This adapter is
# the production implementation. Tests can hand Flow a Belt::Authentication::SessionCookie::MemoryStore
# instead and never load this file.
class SessionStore
  def put_session(session_id:, subject:, refresh_token:, credential_revision:, created_at:, expires_at:)
    Session.create!(
      id: session_id,
      subject: subject,
      refresh_token: refresh_token,
      credential_revision: credential_revision,
      created_at: created_at.iso8601,
      expires_at: expires_at.iso8601
    )
  end

  def load_session(session_id)
    session = Session.find(session_id)
    {
      subject: session.subject,
      refresh_token: session.refresh_token,
      credential_revision: session.credential_revision.to_i,
      expires_at: session.expires_at
    }
  rescue ActiveItem::RecordNotFound
    nil
  end

  def delete_session(session_id)
    Session.find(session_id).destroy
  rescue ActiveItem::RecordNotFound
    nil
  end

  # The credential revision is stored on the user row (User#credential_revision). Bumping it
  # is what fences live sessions.
  def load_subject(subject_id)
    user = User.for_sub(subject_id)
    return nil unless user

    { credential_revision: user.credential_revision.to_i }
  end

  def bump_credential_revision(subject_id)
    user = User.for_sub(subject_id)
    return unless user

    user.update!(credential_revision: user.credential_revision.to_i + 1)
  end
end
