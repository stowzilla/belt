# frozen_string_literal: true

# SessionsController — the session-cookie (PKCE) endpoints.
# Generated by: belt generate auth --session-cookie
#
#   GET  /auth/sign_in   -> 302 to the Cognito Hosted UI (sets PKCE + state cookies)
#   GET  /auth/callback  -> exchanges the code, establishes the server-side session,
#                            sets the opaque HttpOnly session cookie
#   POST /auth/sign_out  -> deletes the session and fences every other one
#
# Wire these in config/routes.rb, e.g.:
#
#   get  'auth/sign_in',  controller: :sessions, action: :sign_in
#   get  'auth/callback', controller: :sessions, action: :callback
#   post 'auth/sign_out', controller: :sessions, action: :sign_out
#
# The refresh token never leaves this server; the browser only ever receives the opaque
# session id. See `belt explain authentication`.
class SessionsController < ApplicationController
  Flow   = Belt::Authentication::SessionCookie::Flow
  Cookie = Belt::Authentication::SessionCookie::Cookie

  def sign_in
    begun = Flow.begin(
      hosted_ui_domain: ENV.fetch('COGNITO_HOSTED_UI_DOMAIN'),
      client_id: ENV.fetch('COGNITO_CLIENT_ID'),
      redirect_uri: ENV.fetch('COGNITO_CALLBACK_URL')
    )
    redirect_to begun[:authorize_url], cookies: begun[:cookies]
  end

  def callback
    cookies = Cookie.parse(request_header('Cookie'))
    result = Flow.complete(
      code: params[:code],
      returned_state: params[:state],
      cookie_state: cookies[Flow::STATE_COOKIE],
      code_verifier: cookies[Flow::VERIFIER_COOKIE],
      subject: subject_from_code_exchange,
      token_exchanger: token_exchanger,
      store: SessionStore.new
    )
    redirect_to ENV.fetch('APP_HOME_URL', '/'), cookies: result[:browser_cookies]
  rescue Flow::Error => e
    error_response("sign-in failed: #{e.message}", :unauthorized)
  end

  def sign_out
    cookies = Cookie.parse(request_header('Cookie'))
    result = Flow.revoke(session_id: cookies[Flow::SESSION_COOKIE], store: SessionStore.new)
    head :no_content, cookies: result[:browser_cookies]
  end

  private

  # Resolve the Cognito subject from the token exchange. The exchanger returns the id token;
  # decode it (Belt::Authentication::Claims) to read `sub`. Left as an app hook because the
  # subject is also what your User row is keyed by.
  def subject_from_code_exchange
    # Implement using your token_exchanger + Belt::Authentication::Claims.decode(id_token)
    raise NotImplementedError, 'resolve the Cognito sub from the exchanged id token'
  end

  def token_exchanger
    # Return an object responding to #exchange_code(code:, code_verifier:) and
    # #refresh(refresh_token:). Wire it to the Cognito token endpoint.
    raise NotImplementedError, 'wire a Cognito token exchanger'
  end
end
