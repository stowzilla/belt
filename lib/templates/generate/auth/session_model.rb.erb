# frozen_string_literal: true

# Session — a server-side sign-in session for the session-cookie (PKCE) flow.
# Generated by: belt generate auth --session-cookie
#
# One row per active browser session. The browser holds only this row's opaque `id` in an
# HttpOnly cookie; the refresh token lives here, on the server, and never reaches the client.
# `credential_revision` is captured at creation so a later revocation (sign-out elsewhere,
# forced logout) fences this session on its next read. See `belt explain authentication`.
class Session < ApplicationRecord
  attr_accessor :subject,             # Cognito sub / user id this session belongs to
                :refresh_token,       # server-side only; never cookied
                :credential_revision, # bound at creation; compared on every read
                :created_at,
                :expires_at

  # subject -> sessions, so a forced revocation can find every live session for a user.
  indexes(
    'SubjectIndex' => { partition_key: 'subject' }
  )
end
