# Cognito User Pool (session-cookie / PKCE flow) — authentication for <%= @app_name %>
# Generated by: belt generate auth --session-cookie
#
# This variant is built for the authorization-code + PKCE flow with a PUBLIC client
# (no secret) and the Hosted UI. The browser never holds a Cognito token: it exchanges
# the code server-side, the refresh token stays on the server, and the client keeps only
# an opaque, HttpOnly session cookie. See `belt explain authentication`.

<% @pools.each do |pool| -%>
resource "aws_cognito_user_pool" "<%= pool[:name] %>" {
  name = "${var.app_name}-${var.environment}<%= pool[:suffix] %>"

  password_policy {
    minimum_length    = 8
    require_lowercase = true
    require_numbers   = true
    require_symbols   = false
    require_uppercase = true
  }

<% unless @signup -%>
  admin_create_user_config {
    allow_admin_create_user_only = true
  }

<% end -%>
  auto_verified_attributes = ["email"]

  account_recovery_setting {
    recovery_mechanism {
      name     = "verified_email"
      priority = 1
    }
  }

  schema {
    name                = "email"
    attribute_data_type = "String"
    required            = true
    mutable             = true

    string_attribute_constraints {
      min_length = 1
      max_length = 256
    }
  }

  deletion_protection = var.environment == "prod" ? "ACTIVE" : "INACTIVE"
}

# Hosted UI domain — where the browser is redirected to sign in. The authorize URL and
# the token endpoint both live under this domain.
resource "aws_cognito_user_pool_domain" "<%= pool[:name] %>" {
  domain       = "${var.app_name}-${var.environment}<%= pool[:suffix] %>"
  user_pool_id = aws_cognito_user_pool.<%= pool[:name] %>.id
}

# PUBLIC client: no secret. PKCE — not a client secret — secures the code exchange, which
# is what lets the exchange happen from a server the SPA talks to without shipping a secret.
resource "aws_cognito_user_pool_client" "<%= pool[:name] %>" {
  name         = "${var.app_name}-${var.environment}<%= pool[:suffix] %>-client"
  user_pool_id = aws_cognito_user_pool.<%= pool[:name] %>.id

  generate_secret = false

  explicit_auth_flows = [
    "ALLOW_REFRESH_TOKEN_AUTH"
  ]

  allowed_oauth_flows_user_pool_client = true
  allowed_oauth_flows                  = ["code"]
  allowed_oauth_scopes                 = ["openid", "email", "profile"]
  supported_identity_providers         = ["COGNITO"]

  # Where Cognito sends the browser back after sign-in / sign-out. These must match the
  # redirect_uri your app passes to SessionCookie::Flow.begin exactly.
  callback_urls = var.cognito_callback_urls
  logout_urls   = var.cognito_logout_urls

  prevent_user_existence_errors = "ENABLED"

  token_validity_units {
    access_token  = "hours"
    id_token      = "hours"
    refresh_token = "days"
  }

  access_token_validity  = 1
  id_token_validity      = 1
  refresh_token_validity = 30
}

<% end -%>
