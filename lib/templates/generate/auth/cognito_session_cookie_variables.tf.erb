# Callback / logout URLs for the session-cookie (PKCE) flow.
# Generated by: belt generate auth --session-cookie
#
# Set these per environment (e.g. infrastructure/dev/terraform.tfvars):
#   cognito_callback_urls = ["https://app.dev.example.com/auth/callback"]
#   cognito_logout_urls   = ["https://app.dev.example.com/"]

variable "cognito_callback_urls" {
  description = "Allowed OAuth callback URLs for the app's session-cookie sign-in"
  type        = list(string)
  default     = ["http://localhost:5173/auth/callback"]
}

variable "cognito_logout_urls" {
  description = "Allowed post-logout redirect URLs"
  type        = list(string)
  default     = ["http://localhost:5173/"]
}
