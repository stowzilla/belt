Belt.application.schema.define do
  # API Contract Definitions — request/response contracts
  #
  # request :create_thing — declares what an endpoint accepts
  # model :thing          — declares what an endpoint returns
  #
  # Example:
  #   request :create_post do
  #     string :title, required: true
  #     string :body, required: true
  #     string :status
  #   end
  #
  #   model :post do
  #     string :id
  #     string :title
  #     string :body
  #     string :status
  #     string :created_at
  #     string :updated_at
  #   end
end
