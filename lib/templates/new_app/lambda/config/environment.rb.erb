# frozen_string_literal: true

# Boot the application. Used by `belt console` and Lambda at runtime.

require 'belt'

ENV['APP_NAME'] ||= '<%= @app_name %>'
ENV['AWS_REGION'] ||= 'us-east-1'

# Load lib and models
Dir[File.join(__dir__, '..', 'lib', '**', '*.rb')].sort.each { |f| require f }

models_dir = File.join(__dir__, '..', 'models')
all_models = Dir[File.join(models_dir, '**', '*.rb')].sort
app_record = all_models.find { |f| File.basename(f) == 'application_record.rb' }
rest = all_models - [app_record].compact
require app_record if app_record
rest.each { |f| require f }

# Load Active Job base and concrete jobs when a jobs plugin is installed.
jobs_dir = File.join(__dir__, '..', 'jobs')
all_jobs = Dir[File.join(jobs_dir, '**', '*.rb')].sort
application_job = all_jobs.find { |f| File.basename(f) == 'application_job.rb' }
remaining_jobs = all_jobs - [application_job].compact
require application_job if application_job
remaining_jobs.each { |f| require f }
