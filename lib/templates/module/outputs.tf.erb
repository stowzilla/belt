output "api_url" {
  description = "API Gateway base URL (custom domain if configured, otherwise default)"
  # Conveyor-belt maps each gateway name as the custom-domain base path (e.g. "api").
  # Bare https://api.<env>.domain returns API Gateway 403; the SPA base URL must
  # include that path so /users → https://api.../api/users.
  value = var.domain != "" ? (
    length(conveyor_belt.main.base_path_mappings) > 0
    ? "https://${local.api_domain}/${values(conveyor_belt.main.base_path_mappings)[0]}"
    : "https://${local.api_domain}"
  ) : values(conveyor_belt.main.api_gateway_urls)[0]
}

output "api_urls" {
  description = "Map of gateway names to API Gateway URLs"
  value       = conveyor_belt.main.api_gateway_urls
}

output "lambda_functions" {
  description = "Map of action names to Lambda function ARNs"
  value       = conveyor_belt.main.lambda_functions
}

output "app_domain" {
  description = "The application domain for this environment"
  value       = local.app_domain
}

output "name_servers" {
  description = "NS records to configure at your registrar"
  value       = local.dns_enabled ? aws_route53_zone.app[0].name_servers : []
}
