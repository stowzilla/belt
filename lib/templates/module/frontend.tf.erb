# Frontend hosting — S3 + CloudFront<% if @include_dns %>
# Custom domain attached when var.domain is set
<% else %>
# Additional frontend '<%= @frontend.name %>' — CloudFront default domain (no Route53)
<% end %>
resource "random_string" "<%= @tf_name %>_suffix" {
  length  = 8
  special = false
  upper   = false
}

# S3 bucket for frontend static assets
resource "aws_s3_bucket" "<%= @tf_name %>" {
  bucket        = "${replace(var.app_name, "_", "-")}-<%= @bucket_slug %>-${var.environment}-${random_string.<%= @tf_name %>_suffix.result}"
  force_destroy = true

  lifecycle {
    ignore_changes = [bucket]
  }
}

resource "aws_s3_bucket_public_access_block" "<%= @tf_name %>" {
  bucket = aws_s3_bucket.<%= @tf_name %>.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "<%= @tf_name %>" {
  bucket = aws_s3_bucket.<%= @tf_name %>.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
    bucket_key_enabled = true
  }
}

# CloudFront OAC
resource "aws_cloudfront_origin_access_control" "<%= @tf_name %>" {
  name                              = "${var.app_name}-${var.environment}-<%= @bucket_slug %>-oac"
  description                       = "OAC for <%= @bucket_slug %> bucket"
  origin_access_control_origin_type = "s3"
  signing_behavior                  = "always"
  signing_protocol                  = "sigv4"
}

# CloudFront distribution
resource "aws_cloudfront_distribution" "<%= @tf_name %>" {
  origin {
    domain_name              = aws_s3_bucket.<%= @tf_name %>.bucket_regional_domain_name
    origin_id                = "S3-${aws_s3_bucket.<%= @tf_name %>.id}"
    origin_access_control_id = aws_cloudfront_origin_access_control.<%= @tf_name %>.id
  }

  enabled             = true
  is_ipv6_enabled     = true
  default_root_object = "index.html"
<% if @include_dns %>
  # Custom domain aliases (if DNS configured)
  aliases = local.dns_enabled ? compact([
    local.app_domain,
    var.environment == "prod" ? "www.${var.domain}" : ""
  ]) : []
<% end %>
  default_cache_behavior {
    allowed_methods        = ["GET", "HEAD", "OPTIONS"]
    cached_methods         = ["GET", "HEAD"]
    target_origin_id       = "S3-${aws_s3_bucket.<%= @tf_name %>.id}"
    compress               = true
    viewer_protocol_policy = "redirect-to-https"

    forwarded_values {
      query_string = false
      cookies {
        forward = "none"
      }
    }

    # Real 404s — see the router resources below.
    function_association {
      event_type   = "viewer-request"
      function_arn = aws_cloudfront_function.<%= @tf_name %>_route_request.arn
    }

    function_association {
      event_type   = "viewer-response"
      function_arn = aws_cloudfront_function.<%= @tf_name %>_route_response.arn
    }
  }

  # SPA fallback — serve index.html for a missing object. The router function
  # sends unknown addresses to /404.html itself; this is what a path gets before
  # routes have been published, and what a missing file (/assets/gone.js) gets.
  custom_error_response {
    error_code         = 404
    response_code      = 200
    response_page_path = "/index.html"
  }

  custom_error_response {
    error_code         = 403
    response_code      = 200
    response_page_path = "/index.html"
  }

  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }

  viewer_certificate {
    cloudfront_default_certificate = <%= @include_dns ? '!local.dns_enabled' : 'true' %>
    acm_certificate_arn            = <%= @include_dns ? 'local.dns_enabled ? (local.is_nested ? data.aws_acm_certificate.parent[0].arn : aws_acm_certificate_validation.app[0].certificate_arn) : null' : 'null' %>
    ssl_support_method             = <%= @include_dns ? 'local.dns_enabled ? "sni-only" : null' : 'null' %>
    minimum_protocol_version       = <%= @include_dns ? 'local.dns_enabled ? "TLSv1.2_2021" : null' : 'null' %>
  }

  tags = {
    Name        = "${var.app_name}-${var.environment}-<%= @bucket_slug %>"
    Environment = var.environment
    ManagedBy   = "Terraform"
  }
}

# Real 404s. `belt deploy frontend` publishes the app's routes (frontend
# src/seo.js: `pages` and `privatePaths`) to this KeyValueStore, and the router
# function serves a page from its prerendered object, an app route from
# index.html, and anything else from /404.html with status 404. The same code
# runs on both events; <%= Belt::CLI::FrontendRoutes::ROUTER_FILE %> is belt's (refresh it with
# `belt frontend router`).
resource "aws_cloudfront_key_value_store" "<%= @tf_name %>_routes" {
  name    = "${var.app_name}-${var.environment}-<%= @bucket_slug %>-routes"
  comment = "Routes published by belt deploy frontend"
}

resource "aws_cloudfront_function" "<%= @tf_name %>_route_request" {
  name                         = "${var.app_name}-${var.environment}-<%= @bucket_slug %>-route-req"
  runtime                      = "cloudfront-js-2.0"
  comment                      = "Send each address to its page, the app, or the 404 page"
  publish                      = true
  key_value_store_associations = [aws_cloudfront_key_value_store.<%= @tf_name %>_routes.arn]
  code                         = file("${path.module}/<%= Belt::CLI::FrontendRoutes::ROUTER_FILE %>")
}

resource "aws_cloudfront_function" "<%= @tf_name %>_route_response" {
  name                         = "${var.app_name}-${var.environment}-<%= @bucket_slug %>-route-res"
  runtime                      = "cloudfront-js-2.0"
  comment                      = "Answer 404 for the 404 page"
  publish                      = true
  key_value_store_associations = [aws_cloudfront_key_value_store.<%= @tf_name %>_routes.arn]
  code                         = file("${path.module}/<%= Belt::CLI::FrontendRoutes::ROUTER_FILE %>")
}

# S3 bucket policy — CloudFront OAC access only
resource "aws_s3_bucket_policy" "<%= @tf_name %>" {
  bucket = aws_s3_bucket.<%= @tf_name %>.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AllowCloudFrontServicePrincipal"
        Effect = "Allow"
        Principal = {
          Service = "cloudfront.amazonaws.com"
        }
        Action   = "s3:GetObject"
        Resource = "${aws_s3_bucket.<%= @tf_name %>.arn}/*"
        Condition = {
          StringEquals = {
            "AWS:SourceArn" = aws_cloudfront_distribution.<%= @tf_name %>.arn
          }
        }
      }
    ]
  })

  depends_on = [aws_s3_bucket_public_access_block.<%= @tf_name %>]
}
<% if @include_dns %>
# Route53 record for frontend (app domain → CloudFront)
resource "aws_route53_record" "<%= @tf_name %>" {
  count   = local.dns_enabled ? 1 : 0
  zone_id = local.is_nested ? data.aws_route53_zone.parent[0].zone_id : aws_route53_zone.app[0].zone_id
  name    = local.app_domain
  type    = "A"

  alias {
    name                   = aws_cloudfront_distribution.<%= @tf_name %>.domain_name
    zone_id                = aws_cloudfront_distribution.<%= @tf_name %>.hosted_zone_id
    evaluate_target_health = false
  }
}

# www record for prod only (standalone envs only — nested envs don't need www)
resource "aws_route53_record" "<%= @tf_name %>_www" {
  count   = local.dns_enabled && var.environment == "prod" && !local.is_nested ? 1 : 0
  zone_id = aws_route53_zone.app[0].zone_id
  name    = "www.${var.domain}"
  type    = "A"

  alias {
    name                   = aws_cloudfront_distribution.<%= @tf_name %>.domain_name
    zone_id                = aws_cloudfront_distribution.<%= @tf_name %>.hosted_zone_id
    evaluate_target_health = false
  }
}
<% end %>
output "<%= @output_prefix %>_bucket_name" {
  value = aws_s3_bucket.<%= @tf_name %>.id
}

output "<%= @output_prefix %>_distribution_id" {
  value = aws_cloudfront_distribution.<%= @tf_name %>.id
}

output "<%= @output_prefix %>_url" {
<% if @include_dns -%>
  value = local.dns_enabled ? "https://${local.app_domain}" : "https://${aws_cloudfront_distribution.<%= @tf_name %>.domain_name}"
<% else -%>
  value = "https://${aws_cloudfront_distribution.<%= @tf_name %>.domain_name}"
<% end -%>
}
