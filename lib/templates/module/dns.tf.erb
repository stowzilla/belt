# DNS configuration for Belt application
# Convention: prod → mydomain.com, other envs → <env>.mydomain.com

locals {
  # Determine the domain for this environment
  app_domain = var.domain != "" ? (
    var.environment == "prod" ? var.domain : "${var.environment}.${var.domain}"
  ) : ""

  # API subdomain: api.mydomain.com (prod) or api.<env>.mydomain.com (non-prod)
  api_domain = var.domain != "" ? "api.${local.app_domain}" : ""

  # Whether DNS is enabled
  dns_enabled = var.domain != ""

  # Whether to create NS delegation records in the root zone
  # (only for non-prod environments with a root_zone_id configured)
  ns_delegation_enabled = local.dns_enabled && var.root_zone_id != "" && var.environment != "prod"
}

# --- Route53 Hosted Zone ---
# One zone per environment subdomain (or root domain for prod)
resource "aws_route53_zone" "app" {
  count = local.dns_enabled ? 1 : 0
  name  = local.app_domain
}

# --- NS Delegation ---
# When root_zone_id is configured, create NS records in the root zone that
# delegate this environment's subdomain to its own hosted zone.
# This allows multi-environment DNS without manual registrar configuration.
resource "aws_route53_record" "ns_delegation" {
  count   = local.ns_delegation_enabled ? 1 : 0
  zone_id = var.root_zone_id
  name    = local.app_domain
  type    = "NS"
  ttl     = 300
  records = aws_route53_zone.app[0].name_servers
}

# --- ACM Certificate ---
# Wildcard cert covers the app domain + all subdomains (api.*, www.*, etc.)
resource "aws_acm_certificate" "app" {
  count                     = local.dns_enabled ? 1 : 0
  domain_name               = local.app_domain
  subject_alternative_names = ["*.${local.app_domain}"]
  validation_method         = "DNS"

  lifecycle {
    create_before_destroy = true
  }
}

# DNS validation record for the certificate
# Key by resource_record_name (not domain_name) because ACM uses identical
# validation records for base domain + wildcard — keying by domain would
# create duplicate CNAME entries that Route 53 rejects.
# Use ellipsis (...) to group duplicates, then take the first element since
# they're identical anyway.
resource "aws_route53_record" "cert_validation" {
  for_each = local.dns_enabled ? {
    for dvo in aws_acm_certificate.app[0].domain_validation_options : dvo.resource_record_name => {
      name   = dvo.resource_record_name
      type   = dvo.resource_record_type
      record = dvo.resource_record_value
    }...
  } : {}

  zone_id = aws_route53_zone.app[0].zone_id
  name    = each.value[0].name
  type    = each.value[0].type
  ttl     = 300
  records = [each.value[0].record]
}

resource "aws_acm_certificate_validation" "app" {
  count                   = local.dns_enabled ? 1 : 0
  certificate_arn         = aws_acm_certificate.app[0].arn
  validation_record_fqdns = [for record in aws_route53_record.cert_validation : record.fqdn]
}

# --- API Gateway Custom Domain ---
resource "aws_api_gateway_domain_name" "api" {
  count                    = local.dns_enabled ? 1 : 0
  domain_name              = local.api_domain
  regional_certificate_arn = aws_acm_certificate_validation.app[0].certificate_arn

  endpoint_configuration {
    types = ["REGIONAL"]
  }
}

# Route53 A record for api.<domain>
resource "aws_route53_record" "api" {
  count   = local.dns_enabled ? 1 : 0
  zone_id = aws_route53_zone.app[0].zone_id
  name    = local.api_domain
  type    = "A"

  alias {
    name                   = aws_api_gateway_domain_name.api[0].regional_domain_name
    zone_id                = aws_api_gateway_domain_name.api[0].regional_zone_id
    evaluate_target_health = false
  }
}
