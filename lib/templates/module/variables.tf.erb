variable "app_name" {
  description = "Name of the application"
  type        = string
}

variable "environment" {
  description = "Environment name (e.g., dev, prod, staging)"
  type        = string
}

variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

variable "domain" {
  description = "Root domain for the application (e.g., myapp.com). Leave empty to skip DNS."
  type        = string
  default     = ""
}

variable "root_zone_id" {
  description = "Root hosted zone ID for NS delegation. When set, each non-prod environment creates NS records in this zone. Get from: cd infrastructure/root && terraform output zone_id"
  type        = string
  default     = ""
}

variable "frontend_urls" {
  description = "URLs allowed for CORS frontend access"
  type        = list(string)
  default     = []
}

variable "lambda_env_refs" {
  description = "Map of reference names to dynamic Terraform values. YAML env_vars use ref(name) to resolve these."
  type        = map(string)
  default     = {}
}

variable "lambda_config" {
  description = "Additional lambda configuration overrides (for dynamic Terraform values)"
  type        = any
  default     = {}
}

variable "enable_pitr" {
  description = "Enable DynamoDB Point-in-Time Recovery (PITR) for all tables"
  type        = bool
  default     = true
}

variable "deletion_protection" {
  description = "Enable deletion protection on DynamoDB tables (prevents accidental terraform destroy)"
  type        = bool
  default     = false
}
