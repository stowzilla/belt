variable "app_name" {
  description = "Name of the application"
  type        = string
}

variable "environment" {
  description = "Environment name (e.g., dev, prod, staging)"
  type        = string
}

variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

variable "domain" {
  description = "Root domain for the application (e.g., myapp.com). Leave empty to skip DNS."
  type        = string
  default     = ""
}

variable "frontend_urls" {
  description = "URLs allowed for CORS frontend access"
  type        = list(string)
  default     = []
}

variable "lambda_config" {
  description = "Additional lambda configuration overrides (for dynamic Terraform values)"
  type        = any
  default     = {}
}
